# Arquivo de exemplo de segredos do Streamlit (.streamlit/secrets.toml.example)
# Renomeie para secrets.toml para desenvolvimento local ou copie os valores
# para a aba "Secrets" nas configurações do seu app no Streamlit Community Cloud.

# Chave de API do Google Gemini (obtenha em https://aistudio.google.com/app/apikey)
GEMINI_API_KEY = "sua_chave_gemini_aqui"

# String de Conexão com o PostgreSQL (ex: Neon Serverless)
DATABASE_URL = "postgresql://usuario:senha@host/database?sslmode=require"
